import java.util.Scanner;

public class FactorialComparison {

    static long factorialIterative(int n) {
        long fact = 1;

        for (int i = 1; i <= n; i++) {
            fact = fact * i;
        }

        return fact;
    }

    static long factorialRecursive(int n) {
        if (n == 0 || n == 1) {
            return 1;
        }

        return n * factorialRecursive(n - 1);
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter a number: ");
        int n = sc.nextInt();

        long iterativeResult = factorialIterative(n);
        long recursiveResult = factorialRecursive(n);

        System.out.println("Factorial using Iterative Method: " + iterativeResult);
        System.out.println("Factorial using Recursive Method: " + recursiveResult);

        sc.close();
    }
}
